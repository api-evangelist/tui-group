			<xsd:documentation xml:lang="nl">Afkortingen van Nederlandse dagen.</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="ma"/>
			<xsd:enumeration value="di"/>
			<xsd:enumeration value="wo"/>
			<xsd:enumeration value="do"/>
			<xsd:enumeration value="vr"/>
			<xsd:enumeration value="za"/>
			<xsd:enumeration value="zo"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="MoneyValue">
		<xsd:annotation>
			<xsd:documentation>Moneynotation.</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:integer">
			<xsd:minInclusive value="0"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:complexType name="PriceValue">
		<xsd:annotation>
			<xsd:documentation>Moneynotation with CurrencyType, PricePer and Sign attributes</xsd:documentation>
		</xsd:annotation>
		<xsd:simpleContent>
			<xsd:extension base="MoneyValue">
				<xsd:attribute name="Currency" use="required" type="CurrencyType" />
				<xsd:attribute name="PricePer" use="required" type="PricePerValue" />
				<xsd:attribute name="Sign">
					<xsd:simpleType>
						<xsd:restriction base="xsd:NMTOKEN">
							<xsd:enumeration value="-" />
