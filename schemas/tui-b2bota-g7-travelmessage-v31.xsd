			<xsd:minInclusive value="0"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="DistanceValue">
		<xsd:annotation>
			<xsd:documentation>Positief heel getal dat een afstand in meters weergeeft.</xsd:documentation>
