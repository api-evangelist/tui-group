					</xsd:simpleType>
				</xsd:attribute>
			</xsd:extension>
		</xsd:simpleContent>
	</xsd:complexType>
	<xsd:simpleType name="TimeValue">
		<xsd:annotation>
			<xsd:documentation>Tijdnotatie als hh:mm.</xsd:documentation>
		</xsd:annotation>
		<!-- SH 2010-09-09: aanpassing 9, pilot projectgroep: pattern bevatte slashes -->
		<xsd:restriction base="xsd:string">
			<xsd:pattern value="[0-2][0-9]:[0-5][0-9](:[0-5][0-9])?"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="PaymentMethodValue">
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="Incasso"/>
			<xsd:enumeration value="incasso"/>
			<xsd:enumeration value="Overmaken"/>
			<xsd:enumeration value="overmaken"/>
			<xsd:enumeration value="DirectIncasso"/>
			<xsd:enumeration value="directincasso"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="YesNoValue">
		<xsd:annotation>
			<xsd:documentation xml:lang="nl">Keuzeattribuut Ja/Nee</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="ja"/>
			<xsd:enumeration value="nee"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="StatusValue">
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="Op aanvraag"/>
			<xsd:enumeration value="op aanvraag"/>
			<xsd:enumeration value="Akkoord"/>
			<xsd:enumeration value="akkoord"/>
			<xsd:enumeration value="Niet akkoord"/>
			<xsd:enumeration value="niet akkoord"/>
			<xsd:enumeration value="Wachtlijst"/>
			<xsd:enumeration value="wachtlijst"/>
			<xsd:enumeration value="Geannuleerd"/>
			<xsd:enumeration value="geannuleerd"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="CurrencyType">
		<xsd:annotation>
			<xsd:documentation>Lijst met currencytypen.</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="EUR"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="DurationTypeValue">
		<xsd:annotation>
			<xsd:documentation>Durationtype: dagen of nachten.</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="dagen"/>
			<xsd:enumeration value="nachten"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="PricePerValue">
		<xsd:annotation>
			<xsd:documentation>PricePer
				Code	Description
				PN	Person per night
				PW	Person per week
				PA	person per arrangement
				KN	Room per night
				KW	Room per week
				KA	Room per arrangement
