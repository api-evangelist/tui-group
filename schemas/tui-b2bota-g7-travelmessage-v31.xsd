	<!-- SH 2010-09-09: aanpassing 15, pilot projectgroep: PaymentMethodValue (en PaymentMethod) toegevoegd -->


	<!-- =================================
     =    Root element               =
     ================================= -->

	<xsd:element name="TravelMessage">
		<!-- wijziging tov v1.4 en v1.5, minoccurs nu op 1 ipv 0 -->

		<!-- 2010-09-30: TCN specific data for vouchers -->
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="Control"/>
				<xsd:choice>
					<xsd:choice>
						<xsd:element ref="TRequest"/>
						<xsd:element ref="TResponse"/>
					</xsd:choice>
					<xsd:element ref="InvoiceMessage" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element ref="TravelDocuments" minOccurs="0"/>
				</xsd:choice>
			</xsd:sequence>
			<xsd:attribute name="VersionID" use="required">
				<xsd:simpleType>
					<xsd:restriction base="xsd:NMTOKEN">
						<xsd:enumeration value="3.1"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:attribute>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="TRequest">
		<!-- Wijziging tov versie 1.4 en v1.5 minOccurs nu op 1 ipv 1 -->
		<xsd:complexType>
			<xsd:sequence>
				<xsd:choice>
					<xsd:element ref="AvailabilityRequest"/>
					<xsd:element ref="SellRequest"/>
					<xsd:element ref="AssignRequest"/>
					<xsd:element ref="BookRequest"/>
					<xsd:element ref="ChangeBookRequest"/>
					<xsd:element ref="SupplyRequest"/>
					<xsd:element ref="PreBookRequest"/>
					<xsd:element ref="RemoveComponentRequest" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element ref="ComplaintRequest"/>
					<xsd:element ref="BookOverviewRequest"/>
					<xsd:element ref="PriceGridRequest" />
					<xsd:element ref="ReceiptRequest" />
				</xsd:choice>
				<xsd:element ref="SecurityInfo" minOccurs="0"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="TResponse">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="PackageDetails" minOccurs="0"/>
				<xsd:element ref="PreBookDetails" minOccurs="0"/>
				<xsd:element ref="Transport" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="Accommodation" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="RoundTrip" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="Cruise" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="AdditionalProducts" minOccurs="0"/>
				<xsd:element ref="PaxDetails" minOccurs="0"/>
				<xsd:element ref="PaxAssignment" minOccurs="0"/>
				<xsd:element ref="PriceInfo" minOccurs="0"/>
				<xsd:element ref="BookResponse" minOccurs="0"/>
				<xsd:element ref="SupplyResponse" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="PreBookResponse" minOccurs="0"/>
				<xsd:element ref="AvailabilityAlternative" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="ChangeBookResponse" minOccurs="0"/>
				<xsd:element ref="RemoveComponentResponse" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="FulfilmentComponent" minOccurs="0"/>
				<xsd:element ref="PaymentComponent" minOccurs="0"/>
				<xsd:element ref="BookOverviewResponse" minOccurs="0"/>
				<xsd:element ref="Messages" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="CancellationPolicy" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="PriceGridResponse" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="ReceiptResponse" minOccurs="0" maxOccurs="1"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="AvailabilityRequest">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:choice>
					<xsd:element ref="PackageDetails"/>
					<xsd:choice maxOccurs="unbounded">
						<xsd:element ref="TransportComponent"/>
						<xsd:element ref="AccommodationComponent"/>
						<xsd:element ref="TransportRentalComponent"/>
						<xsd:element ref="ExtrasComponent"/>
						<xsd:element ref="CruiseComponent"/>
						<xsd:element ref="RoundTripComponent"/>
					</xsd:choice>
				</xsd:choice>
				<xsd:element ref="AdditionalProducts" minOccurs="0"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="SellRequest">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:choice>
					<xsd:element ref="PackageDetails"/>
					<xsd:element ref="ComponentDetails" maxOccurs="unbounded"/>
				</xsd:choice>
				<xsd:element ref="Transport" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="Accommodation" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="RoundTrip" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="Cruise" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="AdditionalProducts" minOccurs="0"/>
				<xsd:element ref="Responsibilities"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="AssignRequest">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="PaxDetails"/>
				<xsd:element ref="PaxAssignment"/>
				<xsd:element ref="Responsibilities"/>
				<xsd:element ref="Discounts" minOccurs="0"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="BookRequest">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="PaxDetails"/>
				<xsd:element ref="PaxAssignment"/>
				<xsd:element ref="FulfilmentComponent" minOccurs="0"/>
				<xsd:element ref="Responsibilities"/>
				<xsd:element ref="Discounts" minOccurs="0"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="SecurityInfo">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="BookID"/>
				<xsd:element ref="DepartureDate" minOccurs="0"/>
				<xsd:element ref="NumberOfAdults" minOccurs="0"/>
				<xsd:element ref="ContactName" minOccurs="0"/>
				<xsd:element ref="SenderID" minOccurs="0"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="AvailabilityAlternative">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="PackageDetails" minOccurs="0"/>
				<xsd:element ref="Transport" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="Accommodation" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="RoundTrip" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="Cruise" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="Messages" minOccurs="0" maxOccurs="unbounded"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="ContactName" type="xsd:string"/>

	<!-- =================================
       =    module Cancellation             =
       ================================= -->

	<xsd:element name="CancellationInformation">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="Description"/>
				<xsd:element ref="Url" minOccurs="0" maxOccurs="1"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>


	<xsd:element name="CancellationPolicy">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="CancellationPeriod" minOccurs="1" maxOccurs="unbounded"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>

	<xsd:element name="CancellationPeriod">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="DateTimeFrom" minOccurs="0" maxOccurs="1">
					<xsd:complexType>
						<xsd:sequence>
							<xsd:element ref="Date"/>
							<xsd:element ref="Time"/>
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
				<xsd:element name="DateTimeTo" minOccurs="0" maxOccurs="1">
					<xsd:complexType>
						<xsd:sequence>
							<xsd:element ref="Date"/>
							<xsd:element ref="Time"/>
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
				<xsd:element ref="Description" minOccurs="0" maxOccurs="1"/>
				<xsd:element name="CancellationRate" type="xsd:integer"/>
				<xsd:element name="CancellationFoundation" type="MoneyValue"/>
				<xsd:element name="CancellationAmmount" type="MoneyValue"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>

	<!-- =================================
    =    module Control             =
    ================================= -->

	<xsd:element name="Control">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="SenderSessionID"/>
				<xsd:element ref="ReceiverSessionID"/>
				<xsd:element ref="Date"/>
				<xsd:element ref="Time"/>
				<xsd:element ref="MessageSequence"/>
				<xsd:element ref="PreviousMessageSequence" minOccurs="0"/>
				<xsd:element ref="SenderID"/>
				<xsd:element ref="ReceiverID"/>
				<xsd:element ref="EmployeeID" minOccurs="0"/>
				<xsd:element ref="RequestID"/>
				<xsd:element ref="ResponseID"/>
				<xsd:element ref="ResponseStatus" minOccurs="0"/>
			</xsd:sequence>
			<xsd:attribute name="Language" use="required">
				<xsd:simpleType>
					<xsd:restriction base="xsd:NMTOKEN">
						<xsd:enumeration value="NL"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:attribute>
			<xsd:attribute name="Test" default="nee" type="YesNoValue"/>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="Date" type="xsd:date"/>
	<xsd:element name="MessageSequence" type="xsd:string"/>
	<xsd:element name="ReceiverSessionID" type="xsd:string"/>
	<xsd:element name="RequestID" type="xsd:string"/>
	<xsd:element name="ResponseID" type="xsd:string"/>
	<xsd:element name="ResponseStatus" type="xsd:string"/>
	<xsd:element name="SenderID" type="xsd:string"/>
	<xsd:element name="ReceiverID" type="xsd:string"/>
	<xsd:element name="EmployeeID" type="xsd:string"/>
	<xsd:element name="SenderSessionID" type="xsd:string"/>
	<xsd:element name="Time">
		<xsd:complexType>
			<xsd:simpleContent>
				<xsd:extension base="TimeValue">
					<xsd:attribute name="Reliability" default="voorbehoud">
						<xsd:simpleType>
							<xsd:restriction base="xsd:NMTOKEN">
								<xsd:enumeration value="zeker"/>
								<xsd:enumeration value="voorbehoud"/>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:attribute>
				</xsd:extension>
			</xsd:simpleContent>
		</xsd:complexType>
	</xsd:element>

	<!-- =================================
     =    module PackageDetails      =
     ================================= -->

	<xsd:element name="PackageDetails">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="PackageID"/>
				<xsd:element ref="Description" minOccurs="0"/>
				<xsd:element ref="Brand" minOccurs="0"/>
				<xsd:element ref="NumberOfAdults"/>
				<xsd:element ref="NumberOfChildren"/>
				<xsd:element ref="NumberOfBabies"/>
				<xsd:element ref="DepartureDate"/>
				<xsd:element ref="DeparturePoint" minOccurs="0"/>
				<xsd:element ref="AccommodationType" minOccurs="0"/>
				<xsd:element ref="BoardType" minOccurs="0"/>
				<xsd:element ref="UnitType" minOccurs="0"/>
				<xsd:element ref="FacilityType" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="Duration"/>
				<xsd:element ref="Alternative" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="MultiMedia" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="PackageType" minOccurs="1" />
			</xsd:sequence>
			<xsd:attribute name="WaitListCheck" default="ja" type="YesNoValue"/>
			<xsd:attribute name="NumberOfAlternatives" type="xsd:integer"/>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="DeparturePoint" type="xsd:string"/>
	<xsd:element name="Duration">
		<xsd:complexType>
			<xsd:simpleContent>
				<xsd:extension base="NumberValue">
					<xsd:attribute name="DurationType" default="dagen" type="DurationTypeValue"/>
				</xsd:extension>
			</xsd:simpleContent>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="NumberOfAdults" type="NumberValue"/>
	<xsd:element name="NumberOfBabies" type="NumberValue"/>
	<xsd:element name="NumberOfChildren" type="NumberValue"/>
	<xsd:element name="PackageID" type="xsd:string"/>
	<xsd:element name="Alternative">
		<xsd:complexType>
			<xsd:choice minOccurs="0">
				<xsd:sequence>
					<xsd:element ref="RangeFrom"/>
					<xsd:element ref="RangeTo"/>
				</xsd:sequence>
				<xsd:element ref="AlternativeTypeList" maxOccurs="unbounded"/>
			</xsd:choice>
			<xsd:attribute name="ElementName" use="required" type="xsd:string"/>
			<xsd:attribute name="Ranking" type="xsd:string"/>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="RangeFrom" type="xsd:string"/>
	<xsd:element name="RangeTo" type="xsd:string"/>
	<xsd:element name="AlternativeTypeList" type="xsd:string"/>
	<xsd:element name="MultiMedia">
		<xsd:complexType>
			<xsd:simpleContent>
				<xsd:extension base="xsd:string">
					<xsd:attribute name="Description" type="xsd:string"/>
					<xsd:attribute name="Format" use="required" type="MultiMediaFormatValues"/>
					<xsd:attribute name="Size" use="required" type="xsd:string"/>
					<xsd:attribute name="ReleaseDate" type="xsd:date"/>
					<xsd:attribute name="Source" type="xsd:string"/>
					<xsd:attribute name="Type" type="MultiMediaTypeValues"/>
					<xsd:attribute name="View" type="MultiMediaViewValues"/>
					<xsd:attribute name="Heigth" type="xsd:string"/>
					<xsd:attribute name="Width" type="xsd:string"/>
					<xsd:attribute name="Length" type="xsd:string"/>
				</xsd:extension>
			</xsd:simpleContent>
		</xsd:complexType>
	</xsd:element>


	<xsd:element name="PackageType" type="PackageTypeType" />

	<xsd:element name="Prices">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="AgeRestrictedPrice" minOccurs="0" maxOccurs="unbounded"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>

	<xsd:element name="AgeRestrictedPrice">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="RecomPrice"/>
				<xsd:element ref="Description"/>
				<xsd:element ref="ExtendedDescription" minOccurs="0"/>
				<xsd:element name="MinAge" type="xsd:integer"/>
				<xsd:element name="MaxAge" type="xsd:integer"/>
			</xsd:sequence>
			<xsd:attribute name="Default" default="nee" />
		</xsd:complexType>
	</xsd:element>

	<!-- ============================================
     =    modules for Components  (availability)=
     ============================================ -->

	<xsd:element name="TransportComponent">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="TransportType"/>
				<xsd:element ref="Departure"/>
				<xsd:element ref="Destination"/>
				<xsd:element ref="NumberOfAdults"/>
				<xsd:element ref="NumberOfChildren" minOccurs="0"/>
				<xsd:element ref="NumberOfBabies" minOccurs="0"/>
				<xsd:element ref="Duration"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="AccommodationComponent">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:choice>
					<xsd:element ref="Destination"/>
					<xsd:element ref="AccommodationID"/>
				</xsd:choice>
				<xsd:element ref="AccommodationType"/>
				<xsd:element ref="BoardType" minOccurs="0"/>
				<xsd:element ref="UnitType" minOccurs="0"/>
				<xsd:element ref="FacilityType" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="ArrivalDate"/>
				<xsd:choice>
					<xsd:element ref="Duration"/>
					<xsd:element ref="DepartureDate"/>
				</xsd:choice>
				<xsd:element ref="NumberOfAdults" minOccurs="0"/>
				<xsd:element ref="NumberOfChildren" minOccurs="0"/>
				<xsd:element ref="NumberOfBabies" minOccurs="0"/>
				<xsd:element ref="NumberOfUnits" minOccurs="0"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="NumberOfUnits" type="NumberValue"/>

	<!-- ============================================
     =    modules for Components  (sellrequest) =
     ============================================ -->

	<xsd:element name="ComponentDetails">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="ComponentID"/>
				<xsd:element ref="Sequence"/>
				<xsd:element ref="ComponentType"/>
				<xsd:element ref="NumberOfAdults"/>
				<xsd:element ref="NumberOfChildren"/>
				<xsd:element ref="NumberOfBabies"/>
				<xsd:element ref="ArrivalDate"/>
				<xsd:choice>
					<xsd:element ref="DepartureDate"/>
					<xsd:element ref="Duration"/>
				</xsd:choice>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="ComponentID" type="xsd:string"/>
	<xsd:element name="ComponentType" type="xsd:string"/>

	<!-- ============================================
     =    module Transport                      =
     ============================================ -->

	<xsd:element name="Transport">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="TransportTo" maxOccurs="unbounded"/>
				<xsd:element ref="TransportFrom" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="PriceNotes" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="AdditionalProducts" minOccurs="0"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="TransportTo">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:choice>
					<xsd:element ref="TransportID"/>
					<xsd:element ref="ComponentID"/>
				</xsd:choice>
				<xsd:element ref="Sequence" minOccurs="0"/>
				<xsd:element ref="TransportType"/>
				<xsd:element ref="Carrier" minOccurs="0"/>
				<xsd:element ref="Departure"/>
				<xsd:element ref="Arrival"/>
				<xsd:element ref="Status" minOccurs="0"/>
				<xsd:element ref="Class" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="MultiMedia" minOccurs="0" maxOccurs="unbounded"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="TransportFrom">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:choice>
					<xsd:element ref="TransportID"/>
					<xsd:element ref="ComponentID"/>
				</xsd:choice>
				<xsd:element ref="Sequence" minOccurs="0"/>
				<xsd:element ref="TransportType"/>
				<xsd:element ref="Carrier" minOccurs="0"/>
				<xsd:element ref="Departure"/>
				<xsd:element ref="Arrival"/>
				<xsd:element ref="Status" minOccurs="0"/>
				<xsd:element ref="Class" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="MultiMedia" minOccurs="0" maxOccurs="unbounded"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="Departure">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="Point"/>
				<xsd:element ref="Date"/>
				<xsd:element ref="Time" minOccurs="0"/>
				<xsd:element ref="PickUp" minOccurs="0" maxOccurs="unbounded"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="Arrival">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="Point"/>
				<xsd:element ref="Date"/>
				<xsd:element ref="Time" minOccurs="0"/>
				<xsd:element ref="DropOff" minOccurs="0" maxOccurs="unbounded"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="Class">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="ClassID"/>
				<xsd:element ref="Description" minOccurs="0"/>
				<xsd:element ref="Seats"/>
				<xsd:element ref="RequiredSeats" minOccurs="0"/>
				<xsd:element ref="Surcharge" minOccurs="0"/>
				<xsd:element ref="PriceNotes" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="CancellationInformation" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="PaxID" minOccurs="0" maxOccurs="unbounded"/>
			</xsd:sequence>
			<xsd:attribute name="Tip">
				<xsd:simpleType>
					<xsd:restriction base="xsd:NMTOKEN">
						<xsd:enumeration value="Yes"/>
						<xsd:enumeration value="No"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:attribute>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="Carrier">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="CarrierID"/>
				<xsd:element ref="Description" minOccurs="0"/>
				<xsd:element ref="FlightNumber" minOccurs="0"/>
				<xsd:element ref="Stopovers" minOccurs="1"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="ClassID" type="xsd:string"/>
	<xsd:element name="Point">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="PointID"/>
				<xsd:element ref="Description" minOccurs="0"/>
				<xsd:element ref="GPSCode" minOccurs="0"/>
			</xsd:sequence>
			<xsd:attribute name="PointType" use="required">
				<xsd:simpleType>
					<xsd:restriction base="xsd:NMTOKEN">
						<xsd:enumeration value="IATAcode"/>
						<xsd:enumeration value="Postcode"/>
						<xsd:enumeration value="Internal"/>
						<xsd:enumeration value="ANVRLandStreek"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:attribute>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="Seats" type="NumberValue"/>
	<xsd:element name="RequiredSeats" type="NumberValue"/>
	<xsd:element name="TransportID" type="xsd:string"/>
	<xsd:element name="CarrierID" type="xsd:string"/>
	<xsd:element name="FlightNumber">
		<xsd:complexType>
			<xsd:simpleContent>
				<xsd:extension base="xsd:string">
					<xsd:attribute name="Charter" default="Yes">
						<xsd:simpleType>
							<xsd:restriction base="xsd:NMTOKEN">
								<xsd:enumeration value="Yes"/>
								<xsd:enumeration value="No"/>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:attribute>
				</xsd:extension>
			</xsd:simpleContent>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="PointID" type="xsd:string"/>

	<xsd:element name="Stopovers">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="Stop" minOccurs="0" maxOccurs="unbounded"/>
			</xsd:sequence>
			<xsd:attribute name="NumberOfStops" type="NumberValue" use="required"/>
		</xsd:complexType>
	</xsd:element>

	<xsd:element name="Stop">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="Arrival" minOccurs="1">
					<xsd:complexType>
						<xsd:sequence>
							<xsd:element ref="Date"/>
							<xsd:element ref="Time" minOccurs="0"/>
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
				<xsd:element name="Departure" minOccurs="1">
					<xsd:complexType>
						<xsd:sequence>
							<xsd:element ref="Date"/>
							<xsd:element ref="Time" minOccurs="0"/>
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
				<xsd:element ref="Point" minOccurs="0"/>
				<xsd:element name="Checkin" minOccurs="0" type="YesNoValue" />
				<xsd:element name="LeaveFlight" minOccurs="0" type="YesNoValue" />
			</xsd:sequence>
			<xsd:attribute name="Index" type="NumberValue"/>
		</xsd:complexType>
	</xsd:element>

	<!-- ============================================
     =    module Accommodation                  =
     ============================================ -->

	<xsd:element name="Accommodation">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:choice>
					<xsd:element ref="AccommodationID"/>
					<xsd:element ref="ComponentID"/>
				</xsd:choice>
				<xsd:element ref="Sequence" minOccurs="0"/>
				<xsd:element ref="AccommodationType"/>
				<xsd:element ref="Name" minOccurs="0"/>
				<xsd:element ref="Address" minOccurs="0"/>
				<xsd:element ref="Zipcode" minOccurs="0"/>
				<xsd:element ref="Place" minOccurs="0"/>
				<xsd:element ref="CountryID" minOccurs="0"/>
				<xsd:element ref="GPSCode" minOccurs="0"/>
				<xsd:element ref="Telephone" minOccurs="0"/>
				<xsd:element ref="ArrivalDate"/>
				<xsd:choice>
					<xsd:element ref="DepartureDate"/>
					<xsd:element ref="Duration"/>
				</xsd:choice>
				<xsd:element ref="Unit" maxOccurs="unbounded"/>
				<xsd:element ref="Arrangement" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="Extras" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="MultiMedia" minOccurs="0" maxOccurs="unbounded"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="Unit">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="UnitID"/>
				<xsd:element ref="UnitType"/>
				<xsd:element ref="UnitDif" minOccurs="0"/>
				<xsd:element ref="Description" minOccurs="0"/>
				<xsd:element ref="RoomNumber" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="Board" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="MinOccupancy" minOccurs="0"/>
				<xsd:element ref="MaxOccupancy" minOccurs="0"/>
				<xsd:element ref="Allotment" minOccurs="0"/>
				<xsd:element ref="RequiredNumber" minOccurs="0"/>
				<xsd:element ref="Status" minOccurs="0"/>
				<xsd:element ref="UnitPrice" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="PriceNotes" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="Facility" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="MultiMedia" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="CancellationInformation" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="RoomAssignment" minOccurs="0" maxOccurs="unbounded"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="Board">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="BoardType"/>
				<xsd:element ref="Description" minOccurs="0"/>
				<xsd:element ref="PriceNotes" minOccurs="0" maxOccurs="unbounded"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="UnitPrice">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="BoardType"/>
				<xsd:element ref="Price"/>
				<xsd:element name="PriceIncluded" type="PriceValue" minOccurs="0"/>
				<xsd:element name="PriceLocalIncluded" type="PriceValue" minOccurs="0"/>
				<xsd:element ref="MutationType" minOccurs="0"/>
				<xsd:element ref="OfferType" minOccurs="0"/>
				<xsd:element ref="Status"/>
				<xsd:element ref="Occupancy"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="Facility">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="FacilityType"/>
				<xsd:element ref="Description" minOccurs="0"/>
				<xsd:element ref="MultiMedia" minOccurs="0" maxOccurs="unbounded"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="Arrangement">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="ArrangementID"/>
				<xsd:element ref="Sequence"/>
				<xsd:element ref="Description" minOccurs="0"/>
				<xsd:element ref="ArrivalDate"/>
				<xsd:element ref="Duration"/>
				<xsd:element ref="Allotment"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="AccommodationID" type="xsd:string"/>
	<xsd:element name="Allotment" type="NumberValue"/>
	<xsd:element name="ArrivalDate" type="xsd:date"/>
	<xsd:element name="Country" type="xsd:string"/>
	<xsd:element name="DepartureDate" type="xsd:date"/>
	<xsd:element name="Description" type="xsd:string"/>
	<xsd:element name="MaxOccupancy">
		<xsd:complexType mixed="true">
			<xsd:choice minOccurs="0" maxOccurs="unbounded">
				<xsd:element ref="Occupation"/>
			</xsd:choice>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="MinOccupancy">
		<xsd:complexType mixed="true">
			<xsd:choice minOccurs="0" maxOccurs="unbounded">
				<xsd:element ref="Occupation"/>
			</xsd:choice>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="Name" type="xsd:string"/>
	<xsd:element name="Place" type="xsd:string"/>
	<xsd:element name="PriceNotes" type="xsd:string"/>
	<xsd:element name="Quantity" type="NumberValue"/>
	<xsd:element name="RecomPrice">
		<xsd:complexType>
			<xsd:simpleContent>
				<xsd:extension base="MoneyValue">
					<xsd:attribute name="Currency" use="required" type="CurrencyType"/>
					<xsd:attribute name="PricePer" use="required" type="PricePerValue"/>
					<xsd:attribute name="Sign">
						<xsd:simpleType>
							<xsd:restriction base="xsd:NMTOKEN">
								<xsd:enumeration value="-"/>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:attribute>
				</xsd:extension>
			</xsd:simpleContent>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="RequiredNumber" type="NumberValue"/>
	<xsd:element name="RoomNumber" type="xsd:string"/>
	<xsd:element name="Status">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="StatusID"/>
				<xsd:element ref="Description"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="Telephone" type="xsd:string"/>
	<xsd:element name="UnitID" type="xsd:string"/>
	<xsd:element name="UnitType" type="UnitTypeValue"/>
	<xsd:element name="UnitDif" type="xsd:string"/>
	<xsd:element name="ArrangementID" type="xsd:string"/>
	<xsd:element name="Occupancy" type="NumberValue"/>

	<!-- ============================================
     =    module RoundTrip                      =
     ============================================ -->

	<xsd:element name="RoundTrip">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="RoundTripID" minOccurs="0"/>
				<xsd:element ref="Sequence" minOccurs="0"/>
				<xsd:element ref="RoundTripTransport" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="Accommodation" minOccurs="0" maxOccurs="unbounded"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="RoundTripID" type="xsd:string"/>
	<xsd:element name="RoundTripTransport">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="TransportID" minOccurs="0"/>
				<xsd:element ref="TransportType" minOccurs="0"/>
				<xsd:element ref="Carrier" minOccurs="0"/>
				<xsd:element ref="Departure"/>
				<xsd:element ref="Arrival"/>
				<xsd:element ref="Status" minOccurs="0"/>
				<xsd:element ref="Class" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="MultiMedia" minOccurs="0" maxOccurs="unbounded"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>

	<!-- ============================================
     =    module Cruise                         =
     ============================================ -->

	<xsd:element name="Cruise">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="CruiseID" minOccurs="0"/>
				<xsd:element ref="Sequence" minOccurs="0"/>
				<xsd:element ref="CruiseTransport" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="Accommodation" minOccurs="0" maxOccurs="unbounded"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="CruiseID" type="xsd:string"/>
	<xsd:element name="CruiseTransport">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="TransportID" minOccurs="0"/>
				<xsd:element ref="Carrier" minOccurs="0"/>
				<xsd:element ref="Departure"/>
				<xsd:element ref="Arrival"/>
				<xsd:element ref="Status" minOccurs="0"/>
				<xsd:element ref="Class" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="MultiMedia" minOccurs="0" maxOccurs="unbounded"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>

	<!-- ============================================
     =    module AdditionalProducts             =
     ============================================ -->

	<xsd:element name="AdditionalProducts">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="Extras" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="TransportRental" minOccurs="0" maxOccurs="unbounded"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="Extras">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="ExtraID"/>
				<xsd:element ref="Sequence" minOccurs="0"/>
				<xsd:element ref="Description"/>
				<xsd:element ref="ExtendedDescription" minOccurs="0"/>
				<xsd:element name="ExtrasCategory" type="ExtrasCategoryType" minOccurs="0"/>
				<xsd:element ref="From" minOccurs="0"/>
				<xsd:element ref="To" minOccurs="0"/>
				<xsd:element ref="Allotment" minOccurs="0"/>
				<xsd:element ref="Status" minOccurs="0"/>
				<xsd:element ref="MinQuantity" minOccurs="0"/>
				<xsd:element ref="MaxQuantity" minOccurs="0"/>
				<xsd:element ref="RecomPrice" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="PriceNotes" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="MinChildAge" minOccurs="0"/>
				<xsd:element ref="MaxChildAge" minOccurs="0"/>
				<xsd:element ref="ChildPrice" minOccurs="0"/>
				<xsd:element ref="MultiMedia" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="RelatedTransport" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="CancellationInformation" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="Prices" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="ExtrasPax" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="GroupID" minOccurs="0"/>
			</xsd:sequence>
			<xsd:attribute name="Required" type="xsd:string"/>
			<xsd:attribute name="CategoryChoice" type="xsd:string"/>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="TransportRental">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="TransportRentalID"/>
				<xsd:element ref="Sequence" minOccurs="0"/>
				<xsd:element ref="Description"/>
				<xsd:element ref="ExtendedDescription" minOccurs="0"/>
				<xsd:element ref="Category" minOccurs="0"/>
				<xsd:element ref="Status" minOccurs="0"/>
				<xsd:element ref="PickUp" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="DropOff" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="RecomPrice" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="PriceNotes" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="Insurance" minOccurs="0"/>
				<xsd:element ref="MultiMedia" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="CancellationInformation" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="PaxID" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="GroupID" minOccurs="0"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="Insurance">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="InsuranceID"/>
				<xsd:element ref="Description"/>
				<xsd:element ref="ExtendedDescription" minOccurs="0"/>
				<xsd:element ref="Category" minOccurs="0"/>
				<xsd:element ref="RecomPrice" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="PriceNotes" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="PriceType" minOccurs="0"/>
				<xsd:element ref="PriceDescription" minOccurs="0"/>
				<xsd:element ref="PolicyCosts" minOccurs="0"/>
				<xsd:element ref="Coverage" minOccurs="0"/>
				<xsd:element ref="Risk" minOccurs="0"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="PickUp">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="Point"/>
				<xsd:element ref="Date"/>
				<xsd:element ref="Time" minOccurs="0"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="DropOff">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="Point"/>
				<xsd:element ref="Date"/>
				<xsd:element ref="Time" minOccurs="0"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="From">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="Date"/>
				<xsd:element ref="Time" minOccurs="0"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="To">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="Date"/>
				<xsd:element ref="Time" minOccurs="0"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="Category" type="xsd:string"/>
	<xsd:element name="ChildPrice">
		<xsd:complexType>
			<xsd:simpleContent>
				<xsd:extension base="MoneyValue">
					<xsd:attribute name="Currency" use="required" type="CurrencyType"/>
					<xsd:attribute name="Sign">
						<xsd:simpleType>
							<xsd:restriction base="xsd:NMTOKEN">
								<xsd:enumeration value="-"/>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:attribute>
				</xsd:extension>
			</xsd:simpleContent>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="Coverage" type="xsd:string"/>
	<xsd:element name="ExtendedDescription" type="xsd:string"/>
	<xsd:element name="GroupID" type="xsd:string"/>
	<xsd:element name="ExtraID" type="xsd:string"/>
	<xsd:element name="InsuranceID" type="xsd:string"/>
	<xsd:element name="MaxChildAge" type="NumberValue"/>
	<xsd:element name="MaxQuantity" type="NumberValue"/>
	<xsd:element name="MinChildAge" type="NumberValue"/>
	<xsd:element name="MinQuantity" type="NumberValue"/>
	<xsd:element name="PolicyCosts">
		<xsd:complexType>
			<xsd:simpleContent>
				<xsd:extension base="MoneyValue">
					<xsd:attribute name="Currency" use="required" type="CurrencyType"/>
					<xsd:attribute name="Sign">
						<xsd:simpleType>
							<xsd:restriction base="xsd:NMTOKEN">
								<xsd:enumeration value="-"/>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:attribute>
				</xsd:extension>
			</xsd:simpleContent>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="PriceDescription" type="xsd:string"/>
	<xsd:element name="Risk" type="xsd:string"/>
	<xsd:element name="TransportRentalID" type="xsd:string"/>
	<xsd:element name="RelatedTransport">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="TransportID"/>
				<xsd:element ref="ClassID"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="Responsibilities">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="SalesResponsibility"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="SalesResponsibility" type="SalesResponsibilityType" />

	<!-- ============================================
     =    module PaxDetails                     =
     ============================================ -->

	<xsd:element name="PaxDetails">
		<xsd:annotation>
			<xsd:documentation>Volledige paxdetails.</xsd:documentation>
		</xsd:annotation>
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="PaxDescription" maxOccurs="unbounded"/>
				<xsd:element ref="Contact" minOccurs="0"/>
				<xsd:element ref="HomeStay"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="PaxDescription">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="PaxID"/>
				<xsd:element ref="GivenNames" minOccurs="0"/>
				<xsd:element ref="Initials"/>
				<xsd:element ref="Infix" minOccurs="0"/>
				<xsd:element ref="Name"/>
				<xsd:choice minOccurs="0">
					<xsd:element ref="DateOfBirth"/>
					<xsd:element ref="Age"/>
				</xsd:choice>
				<xsd:element ref="Gender"/>
				<xsd:element ref="Nationality" minOccurs="0"/>
				<xsd:element ref="PassportNumber" minOccurs="0"/>
				<xsd:element ref="Discounts" minOccurs="0"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="Contact">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="PaxID" minOccurs="0"/>
				<xsd:element ref="Initials"/>
				<xsd:element ref="Infix" minOccurs="0"/>
				<xsd:element ref="Name"/>
				<xsd:element ref="Gender"/>
				<xsd:element ref="Address" minOccurs="0"/>
				<xsd:element ref="Zipcode" minOccurs="0"/>
				<xsd:element ref="Place" minOccurs="0"/>
				<xsd:element ref="Country" minOccurs="0"/>
				<xsd:element ref="TelHome"/>
				<xsd:element ref="TelWork" minOccurs="0"/>
				<xsd:element ref="TelMobile" minOccurs="0"/>
				<xsd:element ref="Email" minOccurs="0"/>
				<xsd:element ref="BankAccount" minOccurs="0"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="HomeStay">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="Initials" minOccurs="0"/>
				<xsd:element ref="Infix" minOccurs="0"/>
				<xsd:element ref="Name"/>
				<xsd:element ref="TelHome"/>
				<xsd:element ref="TelWork" minOccurs="0"/>
				<xsd:element ref="TelMobile" minOccurs="0"/>
				<xsd:element ref="Email" minOccurs="0"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="GivenNames" type="xsd:string"/>
	<xsd:element name="Initials" type="xsd:string"/>
	<xsd:element name="Infix" type="xsd:string"/>
	<xsd:element name="DateOfBirth" type="xsd:date"/>
	<xsd:element name="Age" type="NumberValue"/>
	<xsd:element name="Nationality" type="xsd:string"/>
	<xsd:element name="PaxID" type="xsd:string"/>
	<xsd:element name="Address" type="xsd:string"/>
	<xsd:element name="Zipcode" type="xsd:string"/>
	<xsd:element name="TelHome" type="xsd:string"/>
	<xsd:element name="TelMobile" type="xsd:string"/>
	<xsd:element name="TelWork" type="xsd:string"/>
	<xsd:element name="Email" type="xsd:string"/>
	<xsd:element name="BankAccount" type="xsd:string"/>
	<xsd:element name="PassportNumber" type="xsd:string"/>

	<!-- ============================================
     =    module PaxAssignment                  =
     ============================================ -->

	<xsd:element name="PaxAssignment">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="TransportAssignment" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="AccoAssignment" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="RoundTripAssignment" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="CruiseAssignment" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="PreferencesAndEssentials" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="APAssignment" minOccurs="0"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="TransportAssignment">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:choice>
					<xsd:element ref="TransportID"/>
					<xsd:element ref="ComponentID"/>
				</xsd:choice>
				<xsd:element ref="Sequence" minOccurs="0"/>
				<xsd:element ref="ClassID"/>
				<xsd:element ref="PickUp" minOccurs="0"/>
				<xsd:element ref="DropOff" minOccurs="0"/>
				<xsd:element ref="PaxID" minOccurs="0" maxOccurs="unbounded"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="AccoAssignment">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:choice>
					<xsd:element ref="AccommodationID"/>
					<xsd:element ref="ComponentID"/>
				</xsd:choice>
				<xsd:element ref="Sequence" minOccurs="0"/>
				<xsd:element ref="ArrivalDate"/>
				<xsd:choice>
					<xsd:element ref="Duration"/>
					<xsd:element ref="DepartureDate"/>
				</xsd:choice>
				<xsd:element ref="BoardAssignment" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="UnitAssignment" maxOccurs="unbounded"/>
				<xsd:element ref="ArrangementAssignment" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="ExtrasAssignment" minOccurs="0" maxOccurs="unbounded"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="RoundTripAssignment">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="RoundTripID" minOccurs="0"/>
				<xsd:element ref="TransportAssignment" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="AccoAssignment" minOccurs="0" maxOccurs="unbounded"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="CruiseAssignment">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="CruiseID" minOccurs="0"/>
				<xsd:element ref="TransportAssignment" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="AccoAssignment" minOccurs="0" maxOccurs="unbounded"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="PreferencesAndEssentials">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="PECode"/>
				<xsd:element ref="Description" minOccurs="0"/>
				<xsd:element ref="ObjectID" minOccurs="0"/>
				<xsd:element ref="Sequence" minOccurs="0"/>
				<xsd:element ref="PaxID" minOccurs="0" maxOccurs="unbounded"/>
			</xsd:sequence>
			<xsd:attribute name="PEType" use="required">
				<xsd:simpleType>
					<xsd:restriction base="xsd:NMTOKEN">
						<xsd:enumeration value="E"/>
						<xsd:enumeration value="M"/>
						<xsd:enumeration value="P"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:attribute>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="APAssignment">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="ExtrasAssignment" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="TRentalAssignment" minOccurs="0" maxOccurs="unbounded"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="UnitAssignment">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="UnitID"/>
				<xsd:element ref="Quantity"/>
				<xsd:element ref="RoomAssignment" maxOccurs="unbounded"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="BoardAssignment">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="BoardType"/>
				<xsd:element ref="PaxID" minOccurs="0" maxOccurs="unbounded"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="RoomAssignment">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="Sequence"/>
				<xsd:element ref="RoomNumber" minOccurs="0"/>
				<xsd:element ref="PaxID" maxOccurs="unbounded"/>
			</xsd:sequence>
			<xsd:attribute name="AllInOneRoom" default="nee">
				<xsd:simpleType>
					<xsd:restriction base="xsd:NMTOKEN">
						<xsd:enumeration value="ja"/>
						<xsd:enumeration value="nee"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:attribute>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="ArrangementAssignment">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="ArrangementID"/>
				<xsd:element ref="Sequence"/>
				<xsd:element ref="PaxID" minOccurs="0" maxOccurs="unbounded"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="ExtrasAssignment">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="ExtraID"/>
				<xsd:element ref="Sequence"/>
				<xsd:element ref="From" minOccurs="0"/>
				<xsd:element ref="To" minOccurs="0"/>
				<xsd:element ref="Quantity" minOccurs="0"/>
				<xsd:element ref="ExtrasPax" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="RelatedTransport" minOccurs="0" maxOccurs="unbounded"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="TRentalAssignment">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="TransportRentalID"/>
				<xsd:element ref="Sequence"/>
				<xsd:element ref="PickUp" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="DropOff" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="InsuranceAssignment" minOccurs="0"/>
				<xsd:element ref="PaxID" maxOccurs="unbounded"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="InsuranceAssignment">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="InsuranceID"/>
				<xsd:element ref="PaxID" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="Quantity"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="ExtrasPax">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="PaxID" maxOccurs="unbounded"/>
				<xsd:element ref="Quantity"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="PECode" type="xsd:string"/>
	<xsd:element name="ObjectID" type="xsd:string"/>
	<xsd:element name="Sequence" type="xsd:string"/>
	<xsd:element name="PriceInfo">
		<!-- ============================================
     =    module PriceInfo                      =
     ============================================ -->
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="Price"/>
				<xsd:element ref="PricePaySupplyer" minOccurs="1"/>
				<xsd:element ref="PricePayLocally" minOccurs="0"/>
				<xsd:element ref="TotalCommission" minOccurs="0"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>

	<xsd:element name="AdditionalCharge">
		<xsd:complexType>
			<xsd:simpleContent>
				<xsd:extension base="MoneyValue">
					<xsd:attribute name="Currency" use="required" type="CurrencyType"/>
				</xsd:extension>
			</xsd:simpleContent>
		</xsd:complexType>
	</xsd:element>

	<xsd:element name="Discount">
		<xsd:complexType>
			<xsd:simpleContent>
				<xsd:extension base="MoneyValue">
					<xsd:attribute name="Currency" use="required" type="CurrencyType"/>
				</xsd:extension>
			</xsd:simpleContent>
		</xsd:complexType>
	</xsd:element>


	<xsd:element name="PriceDetails">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="PriceDescription"/>
				<xsd:element ref="PriceCode" minOccurs="0"/>
				<xsd:element ref="Price"/>
				<xsd:element ref="PaxID" minOccurs="0"/>
				<xsd:element ref="Quantity" minOccurs="0"/>
				<xsd:element ref="VATRate" minOccurs="0"/>
				<xsd:element ref="AdditionalCharge" minOccurs="0"/>
				<xsd:element ref="Discount" minOccurs="0"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>

	<xsd:element name="PricePaySupplyer">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="Price"/>
				<xsd:element ref="PriceDetails" maxOccurs="unbounded"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>


	<xsd:element name="PricePayLocally">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="Price"/>
				<xsd:element ref="PriceDetails" maxOccurs="unbounded"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>

	<xsd:element name="Price">
		<xsd:complexType>
			<xsd:simpleContent>
				<xsd:extension base="PriceValue">
					<xsd:attribute name="CommissionPercentage" type="xsd:string" />
					<xsd:attribute name="CommissionAmount" type="xsd:string" />
				</xsd:extension>
			</xsd:simpleContent>
		</xsd:complexType>
	</xsd:element>

	<xsd:element name="BookResponse">
		<!-- ============================================
     =    module BookResponse                   =
     ============================================ -->
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="BookID"/>
				<xsd:element ref="BookEmployeeID" minOccurs="0"/>
				<xsd:element ref="Date"/>
				<xsd:element ref="Time"/>
				<xsd:element ref="OptionDate" minOccurs="0"/>
				<xsd:element ref="Status"/>
				<xsd:element ref="BookInfo" minOccurs="0"/>
				<xsd:element ref="Responsibilities" minOccurs="0" />
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="BookID" type="xsd:string"/>
	<xsd:element name="BookEmployeeID" type="xsd:string"/>
	<xsd:element name="OptionDate" type="xsd:date"/>
	<xsd:element name="BookInfo">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="InvoiceID" minOccurs="0"/>
				<xsd:element ref="InvoiceDate" minOccurs="0"/>
				<xsd:element ref="InvoiceStatus" minOccurs="0"/>
				<xsd:element ref="TravelDocumentsStatus" minOccurs="0"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="InvoiceStatus" type="xsd:string"/>
	<xsd:element name="TravelDocumentsStatus" type="xsd:string"/>
	<xsd:element name="PreBookResponse">
		<!-- ============================================
     =    module PreBookResponse                   =
     ============================================ -->
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="PreBookID"/>
				<xsd:element ref="BookEmployeeID" minOccurs="0"/>
				<xsd:element ref="Date"/>
				<xsd:element ref="Time"/>
				<xsd:element ref="Status"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="PreBookID" type="xsd:string"/>
	<xsd:element name="InvoiceContent">
		<!-- ============================================
     =    module InvoiceResponse                =
     ============================================ -->

		<!-- SH 2010-09-09: aanpassing 7, pilot projectgroep: VATCommission toegevoegd -->

		<!-- SH 2010-09-09: aanpassing 15, pilot projectgroep: PaymentMethod (en PaymentMethodValue) toegevoegd -->

		<!-- SH 2010-09-09: aanpassing 5, pilot projectgroep: PaymentDetails aangepast van {1} naar {0,n} -->
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="BookID"/>
				<xsd:element ref="BookVersionNumber"/>
				<xsd:element ref="InvoiceID"/>
				<xsd:element ref="InvoiceType"/>
				<xsd:element ref="BookDate"/>
				<xsd:element ref="InvoiceDate"/>
				<xsd:element ref="BookAmount"/>
				<xsd:element ref="InvoiceAmount"/>
				<xsd:element ref="CommissionTotal"/>
				<xsd:element ref="VATPrice"/>
				<xsd:element ref="VATCommission"/>
				<xsd:element ref="DepartureDate"/>
				<xsd:element name="PaymentMethod" type="PaymentMethodValue" minOccurs="0"/>
				<xsd:element ref="PaymentDetails" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="InvoiceDetails" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="VATDetails" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="Sender"/>
				<xsd:element ref="Receiver"/>
				<xsd:element ref="PaxDetails" minOccurs="0"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="InvoiceID" type="xsd:string"/>
	<xsd:element name="BookDate" type="xsd:date"/>
	<xsd:element name="InvoiceDate" type="xsd:date"/>
	<xsd:element name="InvoiceAmount">
		<xsd:complexType>
			<xsd:simpleContent>
				<xsd:extension base="MoneyValue">
					<xsd:attribute name="Currency" use="required" type="CurrencyType"/>
					<xsd:attribute name="Sign">
						<xsd:simpleType>
							<xsd:restriction base="xsd:NMTOKEN">
								<xsd:enumeration value="-"/>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:attribute>
				</xsd:extension>
			</xsd:simpleContent>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="Commission">
		<xsd:complexType>
			<xsd:simpleContent>
				<xsd:extension base="MoneyValue">
					<xsd:attribute name="Currency" use="required" type="CurrencyType"/>
					<xsd:attribute name="Sign">
						<xsd:simpleType>
							<xsd:restriction base="xsd:NMTOKEN">
								<xsd:enumeration value="-"/>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:attribute>
				</xsd:extension>
			</xsd:simpleContent>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="VATCommission">
		<xsd:complexType>
			<xsd:simpleContent>
				<xsd:extension base="MoneyValue">
					<xsd:attribute name="Currency" use="required" type="CurrencyType"/>
					<xsd:attribute name="Sign">
						<xsd:simpleType>
							<xsd:restriction base="xsd:NMTOKEN">
								<xsd:enumeration value="-"/>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:attribute>
				</xsd:extension>
			</xsd:simpleContent>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="BookAmount">
		<xsd:complexType>
			<xsd:simpleContent>
				<xsd:extension base="MoneyValue">
					<xsd:attribute name="Currency" use="required" type="CurrencyType"/>
					<xsd:attribute name="Sign">
						<xsd:simpleType>
							<xsd:restriction base="xsd:NMTOKEN">
								<xsd:enumeration value="-"/>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:attribute>
				</xsd:extension>
			</xsd:simpleContent>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="CollectiveAccountID" type="xsd:string"/>
	<xsd:element name="DownPayment">
		<xsd:complexType>
			<xsd:simpleContent>
				<xsd:extension base="MoneyValue">
					<xsd:attribute name="Currency" use="required" type="CurrencyType"/>
					<xsd:attribute name="Sign">
						<xsd:simpleType>
							<xsd:restriction base="xsd:NMTOKEN">
								<xsd:enumeration value="-"/>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:attribute>
				</xsd:extension>
			</xsd:simpleContent>
		</xsd:complexType>
	</xsd:element>
