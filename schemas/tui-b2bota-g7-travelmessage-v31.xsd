			</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="pn"/>
			<xsd:enumeration value="pw"/>
			<xsd:enumeration value="pa"/>
			<xsd:enumeration value="kn"/>
			<xsd:enumeration value="kw"/>
			<xsd:enumeration value="ka"/>
			<xsd:enumeration value="tp"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="MultiMediaFormatValues">
		<xsd:annotation>
			<xsd:documentation>List of supported multimediatypes.
				Images: GIF, JPG, BMP, SVG, EPS and AVI
				Sound:  WAV, MP3
				Text:	XML, HTML, PDF and TXT























			</xsd:documentation>
