						<xsd:simpleType>
							<xsd:restriction base="xsd:NMTOKEN">
								<xsd:enumeration value="-"/>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:attribute>
				</xsd:extension>
			</xsd:simpleContent>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="Attribute">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="Description"/>
				<xsd:element ref="Value"/>
			</xsd:sequence>
			<xsd:attribute name="code" type="xsd:string"/>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="Value">
		<xsd:complexType>
			<xsd:simpleContent>
				<xsd:extension base="xsd:string">
					<xsd:attribute name="type" type="xsd:string"/>
				</xsd:extension>
			</xsd:simpleContent>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="ShortDescription">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="Title" minOccurs="0"/>
				<xsd:element ref="P" maxOccurs="unbounded"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="Text">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="Title" minOccurs="0"/>
				<xsd:element ref="Sequence" minOccurs="0"/>
				<xsd:element ref="TextContent"/>
			</xsd:sequence>
			<xsd:attribute name="type" type="xsd:string"/>
			<xsd:attribute name="summer" default="ja">
				<xsd:simpleType>
					<xsd:restriction base="xsd:NMTOKEN">
						<xsd:enumeration value="ja"/>
						<xsd:enumeration value="nee"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:attribute>
			<xsd:attribute name="winter" default="ja">
				<xsd:simpleType>
					<xsd:restriction base="xsd:NMTOKEN">
						<xsd:enumeration value="ja"/>
						<xsd:enumeration value="nee"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:attribute>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="Image">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="Title" minOccurs="0"/>
				<xsd:element ref="Sequence" minOccurs="0"/>
				<xsd:element ref="Url"/>
			</xsd:sequence>
			<xsd:attribute name="imagetype" type="xsd:string"/>
			<xsd:attribute name="summer" type="xsd:string"/>
			<xsd:attribute name="winter" type="xsd:string"/>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="Url" type="xsd:string"/>
	<xsd:element name="Title" type="xsd:string"/>
	<xsd:element name="TextContent">
		<xsd:complexType mixed="true">
			<xsd:choice minOccurs="0" maxOccurs="unbounded">
				<xsd:element ref="Text"/>
				<xsd:element ref="P"/>
				<xsd:element ref="Ref"/>
			</xsd:choice>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="P">
		<xsd:complexType mixed="true">
			<xsd:choice minOccurs="0" maxOccurs="unbounded">
				<xsd:element ref="List"/>
				<xsd:element ref="Table"/>
				<xsd:element ref="B"/>
				<xsd:element ref="I"/>
				<xsd:element ref="U"/>
				<xsd:element ref="Ref"/>
			</xsd:choice>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="List">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="Li" maxOccurs="unbounded"/>
			</xsd:sequence>
			<xsd:attribute name="type" default="bull">
				<xsd:simpleType>
					<xsd:restriction base="xsd:NMTOKEN">
						<xsd:enumeration value="a"/>
						<xsd:enumeration value="1"/>
						<xsd:enumeration value="bull"/>
						<xsd:enumeration value="dash"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:attribute>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="Li" type="xsd:string"/>
	<xsd:element name="B" type="xsd:string"/>
	<xsd:element name="U" type="xsd:string"/>
	<xsd:element name="I" type="xsd:string"/>
	<xsd:element name="Ref">
		<xsd:complexType>
			<xsd:simpleContent>
				<xsd:extension base="xsd:string">
					<xsd:attribute name="href" type="xsd:string"/>
					<xsd:attribute name="target" type="xsd:string"/>
				</xsd:extension>
			</xsd:simpleContent>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="UnitInfo">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="UnitID"/>
				<xsd:element ref="UnitType"/>
				<xsd:element ref="UnitDif" minOccurs="0"/>
				<xsd:element ref="Description" minOccurs="0"/>
				<xsd:element ref="Text" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="MinOccupancy" minOccurs="0"/>
				<xsd:element ref="MaxOccupancy" minOccurs="0"/>
				<xsd:element ref="FacilityInfo" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="BoardInfo" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="PriceInfo" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="PriceNotes" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="RoomAssignment" minOccurs="0" maxOccurs="unbounded"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="TransportInfo">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="DepartureInfo" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="ArrivalInfo" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="ClassInfo" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="PriceNotes" minOccurs="0" maxOccurs="unbounded"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="Table">
		<!--
     ======================================================================================
     = Table                                                                              =
     = 'table' contains the CALS definition of tables                                     =
     ======================================================================================
-->
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="tgroup" maxOccurs="unbounded"/>
			</xsd:sequence>
			<xsd:attribute name="tabstyle" type="xsd:string"/>
			<xsd:attribute name="tocentry" default="1" type="xsd:string"/>
			<xsd:attribute name="shortentry" type="xsd:string"/>
			<xsd:attribute name="frame">
				<xsd:simpleType>
					<xsd:restriction base="xsd:NMTOKEN">
						<xsd:enumeration value="top"/>
						<xsd:enumeration value="bottom"/>
						<xsd:enumeration value="topbot"/>
						<xsd:enumeration value="all"/>
						<xsd:enumeration value="sides"/>
						<xsd:enumeration value="none"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:attribute>
			<xsd:attribute name="colsep" type="xsd:string"/>
			<xsd:attribute name="rowsep" type="xsd:string"/>
			<xsd:attribute name="orient">
				<xsd:simpleType>
					<xsd:restriction base="xsd:NMTOKEN">
						<xsd:enumeration value="port"/>
						<xsd:enumeration value="land"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:attribute>
			<xsd:attribute name="pgwide" type="xsd:string"/>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="tgroup">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="colspec" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="spanspec" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="thead" minOccurs="0"/>
				<xsd:element ref="tfoot" minOccurs="0"/>
				<xsd:element ref="tbody"/>
			</xsd:sequence>
			<xsd:attribute name="cols" use="required" type="xsd:string"/>
			<xsd:attribute name="tgroupstyle" type="xsd:string"/>
			<xsd:attribute name="colsep" type="xsd:string"/>
			<xsd:attribute name="rowsep" type="xsd:string"/>
			<xsd:attribute name="align" default="left">
				<xsd:simpleType>
					<xsd:restriction base="xsd:NMTOKEN">
						<xsd:enumeration value="left"/>
						<xsd:enumeration value="right"/>
						<xsd:enumeration value="center"/>
						<xsd:enumeration value="justify"/>
						<xsd:enumeration value="char"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:attribute>
			<xsd:attribute name="charoff" default="50" type="xsd:string"/>
			<xsd:attribute name="char" default="" type="xsd:string"/>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="colspec">
		<xsd:complexType>
			<xsd:attribute name="colnum" type="xsd:string"/>
			<xsd:attribute name="colname" type="xsd:string"/>
			<xsd:attribute name="align">
				<xsd:simpleType>
					<xsd:restriction base="xsd:NMTOKEN">
						<xsd:enumeration value="left"/>
						<xsd:enumeration value="right"/>
						<xsd:enumeration value="center"/>
						<xsd:enumeration value="justify"/>
						<xsd:enumeration value="char"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:attribute>
			<xsd:attribute name="charoff" type="xsd:string"/>
			<xsd:attribute name="char" type="xsd:string"/>
			<xsd:attribute name="colwidth" type="xsd:string"/>
			<xsd:attribute name="colsep" type="xsd:string"/>
			<xsd:attribute name="rowsep" type="xsd:string"/>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="spanspec">
		<xsd:complexType>
			<xsd:attribute name="namest" use="required" type="xsd:string"/>
			<xsd:attribute name="nameend" use="required" type="xsd:string"/>
			<xsd:attribute name="spanname" use="required" type="xsd:string"/>
			<xsd:attribute name="align" default="center">
				<xsd:simpleType>
					<xsd:restriction base="xsd:NMTOKEN">
						<xsd:enumeration value="left"/>
						<xsd:enumeration value="right"/>
						<xsd:enumeration value="center"/>
						<xsd:enumeration value="justify"/>
						<xsd:enumeration value="char"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:attribute>
			<xsd:attribute name="charoff" type="xsd:string"/>
			<xsd:attribute name="char" type="xsd:string"/>
			<xsd:attribute name="colsep" type="xsd:string"/>
			<xsd:attribute name="rowsep" type="xsd:string"/>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="thead">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="colspec" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="row" maxOccurs="unbounded"/>
			</xsd:sequence>
			<xsd:attribute name="valign" default="bottom">
				<xsd:simpleType>
					<xsd:restriction base="xsd:NMTOKEN">
						<xsd:enumeration value="top"/>
						<xsd:enumeration value="middle"/>
						<xsd:enumeration value="bottom"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:attribute>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="tfoot">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="colspec" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="row" maxOccurs="unbounded"/>
			</xsd:sequence>
			<xsd:attribute name="valign" default="top">
				<xsd:simpleType>
					<xsd:restriction base="xsd:NMTOKEN">
						<xsd:enumeration value="top"/>
						<xsd:enumeration value="middle"/>
						<xsd:enumeration value="bottom"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:attribute>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="tbody">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="row" maxOccurs="unbounded"/>
			</xsd:sequence>
			<xsd:attribute name="valign" default="top">
				<xsd:simpleType>
					<xsd:restriction base="xsd:NMTOKEN">
						<xsd:enumeration value="top"/>
						<xsd:enumeration value="middle"/>
						<xsd:enumeration value="bottom"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:attribute>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="row">
		<xsd:complexType>
			<xsd:sequence maxOccurs="unbounded">
				<xsd:element ref="entry"/>
			</xsd:sequence>
			<xsd:attribute name="rowsep" type="xsd:string"/>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="entry">
		<xsd:complexType mixed="true">
			<xsd:choice minOccurs="0" maxOccurs="unbounded">
				<xsd:element ref="P"/>
			</xsd:choice>
			<xsd:attribute name="colname" type="xsd:string"/>
			<xsd:attribute name="namest" type="xsd:string"/>
			<xsd:attribute name="nameend" type="xsd:string"/>
			<xsd:attribute name="spanname" type="xsd:string"/>
			<xsd:attribute name="morerows" default="0" type="xsd:string"/>
			<xsd:attribute name="colsep" type="xsd:string"/>
			<xsd:attribute name="rowsep" type="xsd:string"/>
			<xsd:attribute name="rotate" default="0" type="xsd:string"/>
			<xsd:attribute name="valign">
				<xsd:simpleType>
					<xsd:restriction base="xsd:NMTOKEN">
						<xsd:enumeration value="top"/>
						<xsd:enumeration value="bottom"/>
						<xsd:enumeration value="middle"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:attribute>
			<xsd:attribute name="align">
				<xsd:simpleType>
					<xsd:restriction base="xsd:NMTOKEN">
						<xsd:enumeration value="left"/>
						<xsd:enumeration value="right"/>
						<xsd:enumeration value="center"/>
						<xsd:enumeration value="justify"/>
						<xsd:enumeration value="char"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:attribute>
			<xsd:attribute name="charoff" type="xsd:string"/>
			<xsd:attribute name="char" type="xsd:string"/>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="Occupation">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="Quantity"/>
				<xsd:element ref="Condition" minOccurs="0" maxOccurs="unbounded"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="Condition">
		<xsd:complexType>
			<xsd:choice>
				<xsd:element ref="NumberOfPersons"/>
				<xsd:element ref="AgeCondition" minOccurs="0"/>
			</xsd:choice>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="NumberOfPersons" type="NumberValue"/>
	<xsd:element name="AgeCondition">
		<xsd:complexType>
			<xsd:simpleContent>
				<xsd:extension base="xsd:string">
					<xsd:attribute name="AgeType" use="required" type="xsd:string"/>
				</xsd:extension>
			</xsd:simpleContent>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="VATRate" type="NumberValue"/>
	<xsd:element name="InvoiceDetails">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="PriceDescription"/>
				<xsd:element ref="PriceCode" minOccurs="0"/>
				<xsd:element ref="Price"/>
				<xsd:element ref="VATIdentifier"/>
				<xsd:element ref="PaxID" minOccurs="0"/>
				<xsd:element ref="CommissionDetails" minOccurs="0"/>
				<xsd:element ref="RelatedInvoiceID" minOccurs="0"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="Sender">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="Name"/>
				<xsd:element ref="Address"/>
				<xsd:element ref="Zipcode"/>
				<xsd:element ref="Place"/>
				<xsd:element ref="Country"/>
				<xsd:element ref="VATIdentificationNumber"/>
				<xsd:element ref="Bank"/>
				<xsd:element ref="BankAccountNumber"/>
				<xsd:element ref="IBAN"/>
				<xsd:element ref="BIC"/>
				<xsd:element ref="COC"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="Receiver">
		<!-- SH 2010-09-09: aanpassing 6, pilot projectgroep: VATIdentificationNumber optioneel gemaakt -->

		<!-- SH 2010-09-09: aanpassing 4, pilot projectgroep: BookEmployeeID toegevoegd -->
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="ReceiverID"/>
				<xsd:element ref="Name"/>
				<xsd:element ref="Address"/>
				<xsd:element ref="Zipcode"/>
				<xsd:element ref="Place"/>
				<xsd:element ref="Country"/>
				<xsd:element ref="VATIdentificationNumber" minOccurs="0"/>
				<xsd:element ref="BookEmployeeID" minOccurs="0"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="VATIdentificationNumber" type="xsd:string"/>
	<xsd:element name="PreviousMessageSequence" type="xsd:string"/>
	<xsd:element name="GPSCode">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="Latitude"/>
				<xsd:element ref="Longitude"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="Latitude">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="LatitudeDegrees"/>
				<xsd:element ref="LatitudeMinutes"/>
				<xsd:element ref="LatitudeSeconds"/>
				<xsd:element ref="LatitudeDecimal"/>
			</xsd:sequence>
			<xsd:attribute name="LatitudeDirection" use="required">
				<xsd:simpleType>
					<xsd:restriction base="xsd:NMTOKEN">
						<xsd:enumeration value="N"/>
						<xsd:enumeration value="Z"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:attribute>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="Longitude">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="LongitudeDegrees"/>
				<xsd:element ref="LongitudeMinutes"/>
				<xsd:element ref="LongitudeSeconds"/>
				<xsd:element ref="LongitudeDecimal"/>
			</xsd:sequence>
			<xsd:attribute name="LongitudeDirection" use="required">
				<xsd:simpleType>
					<xsd:restriction base="xsd:NMTOKEN">
						<xsd:enumeration value="O"/>
						<xsd:enumeration value="W"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:attribute>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="LatitudeDegrees" type="NumberValue"/>
	<xsd:element name="LatitudeMinutes" type="NumberValue"/>
	<xsd:element name="LatitudeSeconds" type="NumberValue"/>
	<xsd:element name="LatitudeDecimal" type="NumberValue"/>
	<xsd:element name="LongitudeDegrees" type="NumberValue"/>
	<xsd:element name="LongitudeMinutes" type="NumberValue"/>
	<xsd:element name="LongitudeSeconds" type="NumberValue"/>
	<xsd:element name="LongitudeDecimal" type="NumberValue"/>
	<xsd:element name="SupplyPackage">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="MutationType"/>
				<xsd:element ref="OfferType"/>
				<xsd:element ref="Brand"/>
				<xsd:element ref="PackageID"/>
				<xsd:element ref="PackageInfo" minOccurs="0"/>
				<xsd:element ref="SupplyTransportInfo" minOccurs="0"/>
				<xsd:element ref="SupplyAccoInfo" minOccurs="0"/>
				<xsd:element ref="SupplyPriceAvailabilityInfo" minOccurs="0" maxOccurs="unbounded"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="PackageInfo">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="Description"/>
				<xsd:element ref="PublicationPeriod" minOccurs="0"/>
				<xsd:element ref="BookPeriod" minOccurs="0"/>
				<xsd:element ref="TravelPeriod" minOccurs="0"/>
				<xsd:element ref="Category" minOccurs="0"/>
				<xsd:element ref="Reference" minOccurs="0"/>
				<xsd:element ref="ImageGroup" minOccurs="0"/>
				<xsd:element ref="TextGroup" minOccurs="0"/>
				<xsd:element ref="PropertyGroup" minOccurs="0"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="SupplyPriceAvailabilityInfo">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="DepartureDate"/>
				<xsd:element ref="Duration"/>
				<xsd:sequence>
					<xsd:element ref="CarrierGroup" minOccurs="0"/>
					<xsd:element ref="SupplyPriceAvailability" maxOccurs="unbounded"/>
				</xsd:sequence>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="BookPeriod">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="StartDate"/>
				<xsd:element ref="EndDate"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="TravelPeriod">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="StartDate"/>
				<xsd:element ref="EndDate"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="ImageGroup">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="Image" maxOccurs="unbounded"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="TextGroup">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="Text" maxOccurs="unbounded"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="PropertyGroup">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="PropertyItem" maxOccurs="unbounded"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="CarrierGroup">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="CarrierItem" maxOccurs="unbounded"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="SupplyPriceAvailability">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="RouteID"/>
				<xsd:element ref="UnitID"/>
				<xsd:element ref="UnitPrice" maxOccurs="unbounded"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="PropertyItem">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="PropertyCode"/>
				<xsd:element ref="Description"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="CarrierItem">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="CarrierID"/>
				<xsd:element ref="Description"/>
				<xsd:element ref="Class" maxOccurs="unbounded"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="RouteID" type="xsd:string"/>
	<xsd:element name="PropertyCode" type="xsd:string"/>
	<xsd:element name="Route">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="SupplyTransportTo" minOccurs="0"/>
				<xsd:element ref="SupplyTransportFrom" minOccurs="0"/>
				<xsd:element ref="PriceNotes"/>
			</xsd:sequence>
			<xsd:attribute name="RouteID" use="required" type="xsd:string"/>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="SupplyTransportFrom">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="TransportType"/>
				<xsd:element ref="DepartureInfo"/>
				<xsd:element ref="ArrivalInfo"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="SupplyTransportTo">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="TransportType"/>
				<xsd:element ref="DepartureInfo"/>
				<xsd:element ref="ArrivalInfo"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="BookOverviewRequest">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="OfficeID" minOccurs="0"/>
				<xsd:element ref="From"/>
				<xsd:element ref="To"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="BookOverviewResponse">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="BookOverviewItem" maxOccurs="unbounded"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>

	<!-- ======================================================================================
     =    module ReceiptRequest                                                                                                                              =
     ======================================================================================   -->
	<xsd:element name="ReceiptRequest">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="PackageDetails" minOccurs="0">
					<xsd:complexType>
						<xsd:sequence>
							<xsd:element ref="PackageID"/>
							<xsd:element ref="DepartureDate"/>
							<xsd:element ref="Duration" />
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
				<xsd:element name="PaxDetails" minOccurs="0" maxOccurs="unbounded">
					<xsd:complexType>
						<xsd:sequence>
							<xsd:element ref="PaxID"/>
							<xsd:element ref="DateOfBirth"/>
							<xsd:element ref="Discounts" minOccurs="0"/>
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
				<xsd:element ref="Transport" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="Accommodation" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="AdditionalProducts" minOccurs="0" />
				<xsd:element ref="Discounts" minOccurs="0"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>

	<xsd:element name="ReceiptResponse">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="Transport" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="Accommodation" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="PriceInfo"  minOccurs="0" />
				<xsd:element ref="CancellationPolicy" minOccurs="0"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>

	<xsd:element name="PriceGridRequest">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="PackageDetails" minOccurs="0">
					<xsd:complexType>
						<xsd:sequence>
							<xsd:element ref="PackageID"/>
							<xsd:element name="DepartureDateRange">
								<xsd:complexType>
									<xsd:attribute name="min" type="xsd:date"/>
									<xsd:attribute name="max" type="xsd:date"/>
								</xsd:complexType>
							</xsd:element>
							<xsd:element name="DurationRange">
								<xsd:complexType>
									<xsd:attribute name="min" type="xsd:integer"/>
									<xsd:attribute name="max" type="xsd:integer"/>
								</xsd:complexType>
							</xsd:element>
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
				<xsd:element name="PaxDetails" minOccurs="0" maxOccurs="unbounded">
					<xsd:complexType>
						<xsd:sequence>
							<xsd:element ref="PaxID"/>
							<xsd:element ref="DateOfBirth"/>
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
				<xsd:element name="Transport" minOccurs="0" maxOccurs="unbounded">
					<xsd:complexType>
						<xsd:sequence>
							<xsd:element ref="DepartureInfo" minOccurs="0" />
							<xsd:element ref="ArrivalInfo" minOccurs="0" />
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
				<xsd:element name="Accommodation">
					<xsd:complexType>
						<xsd:sequence>
							<xsd:element ref="UnitInfo" minOccurs="0" />
							<xsd:element ref="FacilityInfo" minOccurs="0"/>
							<xsd:element ref="BoardInfo" minOccurs="0"/>
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>

	<xsd:element name="PriceGridResponse">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="SupplyPriceAvailabilityInfo" minOccurs="0" maxOccurs="unbounded"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>


	<xsd:element name="BookOverviewItem">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="BookID"/>
				<xsd:element ref="OfficeID"/>
				<xsd:element ref="BookEmployeeID"/>
				<xsd:element ref="Date"/>
				<xsd:element ref="Time"/>
				<xsd:element ref="OptionDate" minOccurs="0"/>
				<xsd:element ref="ClientName" minOccurs="0"/>
				<xsd:element ref="AccommodationName" minOccurs="0"/>
				<xsd:element ref="DepartureDate" minOccurs="0"/>
				<xsd:element ref="Status"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="Surcharge">
		<xsd:complexType>
			<xsd:simpleContent>
				<xsd:extension base="MoneyValue">
					<xsd:attribute name="Currency" use="required" type="CurrencyType"/>
					<xsd:attribute name="Sign">
						<xsd:simpleType>
							<xsd:restriction base="xsd:NMTOKEN">
								<xsd:enumeration value="-"/>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:attribute>
				</xsd:extension>
			</xsd:simpleContent>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="StatusID" type="xsd:string"/>
	<xsd:element name="OfficeID" type="xsd:string"/>
	<xsd:element name="AccommodationName" type="xsd:string"/>
	<xsd:element name="InvoiceMessage">
		<!-- SH 2010-09-09: aanpassing 14, pilot projectgroep: InvoiceSignature verwijderd  				
					<xsd:element ref = "InvoiceSignature"/> -->

		<!-- SH 2010-09-09: aanpassing 1, pilot projectgroep: PDFDocument toegevoegd -->
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="InvoiceContent"/>
				<xsd:element ref="PDFDocument" minOccurs="0"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="BankAccountNumber" type="xsd:string"/>
	<xsd:element name="VATCommision">
		<xsd:complexType>
			<xsd:simpleContent>
				<xsd:extension base="MoneyValue">
					<xsd:attribute name="Currency" use="required" type="CurrencyType"/>
					<xsd:attribute name="Sign">
						<xsd:simpleType>
							<xsd:restriction base="xsd:NMTOKEN">
								<xsd:enumeration value="-"/>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:attribute>
				</xsd:extension>
			</xsd:simpleContent>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="VATAmount">
		<xsd:complexType>
			<xsd:simpleContent>
				<xsd:extension base="MoneyValue">
					<xsd:attribute name="Currency" use="required" type="CurrencyType"/>
					<xsd:attribute name="Sign">
						<xsd:simpleType>
							<xsd:restriction base="xsd:NMTOKEN">
								<xsd:enumeration value="-"/>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:attribute>
				</xsd:extension>
			</xsd:simpleContent>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="VATIdentifier" type="xsd:string"/>
	<xsd:element name="VATPrice">
		<xsd:complexType>
			<xsd:simpleContent>
				<xsd:extension base="MoneyValue">
					<xsd:attribute name="Currency" use="required" type="CurrencyType"/>
					<xsd:attribute name="Sign">
						<xsd:simpleType>
							<xsd:restriction base="xsd:NMTOKEN">
								<xsd:enumeration value="-"/>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:attribute>
				</xsd:extension>
			</xsd:simpleContent>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="Bank" type="xsd:string"/>
	<xsd:element name="IBAN" type="xsd:string"/>
	<xsd:element name="COC" type="xsd:string"/>
	<xsd:element name="TravelDocuments">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="TravelDocumentsMeta"/>
				<xsd:element ref="TravelDocumentItem" minOccurs="0" maxOccurs="unbounded"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="SignatureMethod" type="xsd:string"/>
	<xsd:element name="SignatureHashCount" type="xsd:string"/>
	<xsd:element name="BookVersionNumber" type="NumberValue"/>
	<xsd:element name="PaymentDetails">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="PaymentAmount"/>
				<xsd:element ref="ExpiryDatePayment"/>
				<xsd:element ref="PaymentReference" minOccurs="0"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="PaymentAmount">
		<xsd:complexType>
			<xsd:simpleContent>
				<xsd:extension base="MoneyValue">
					<xsd:attribute name="Currency" use="required" type="CurrencyType"/>
					<xsd:attribute name="Sign">
						<xsd:simpleType>
							<xsd:restriction base="xsd:NMTOKEN">
								<xsd:enumeration value="-"/>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:attribute>
				</xsd:extension>
			</xsd:simpleContent>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="ExpiryDatePayment" type="xsd:date"/>
	<xsd:element name="PaymentReference" type="xsd:string"/>
	<xsd:element name="VATDetails">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="VATIdentifier"/>
				<xsd:element ref="VATFoundation"/>
				<xsd:element ref="VATRate"/>
				<xsd:element ref="VATAmount"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="VATFoundation">
		<xsd:complexType>
			<xsd:simpleContent>
				<xsd:extension base="MoneyValue">
					<xsd:attribute name="Currency" use="required" type="CurrencyType"/>
					<xsd:attribute name="Sign">
						<xsd:simpleType>
							<xsd:restriction base="xsd:NMTOKEN">
								<xsd:enumeration value="-"/>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:attribute>
				</xsd:extension>
			</xsd:simpleContent>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="CommissionDetails">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="VATIdentifier"/>
				<xsd:element ref="CommissionFoundation"/>
				<xsd:element ref="Commission"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="CommissionFoundation">
		<xsd:complexType>
			<xsd:simpleContent>
				<xsd:extension base="MoneyValue">
					<xsd:attribute name="Currency" use="required" type="CurrencyType"/>
					<xsd:attribute name="Sign">
						<xsd:simpleType>
							<xsd:restriction base="xsd:NMTOKEN">
								<xsd:enumeration value="-"/>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:attribute>
				</xsd:extension>
			</xsd:simpleContent>
		</xsd:complexType>
	</xsd:element>

	<!-- SH 2010-09-09: aanpassing 2, pilot projectgroep: domein PDFDocument aangepast van string naar base64Binary -->

	<xsd:element name="PDFDocument" type="xsd:base64Binary"/>
	<xsd:element name="DocumentID" type="xsd:string"/>
	<xsd:element name="InvoiceType">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="InvoiceTypeID"/>
				<xsd:element ref="Description" minOccurs="0"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="CommissionTotal">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="Commission"/>
				<xsd:element ref="VATIdentifier"/>
				<xsd:element ref="CommissionFoundation"/>
			</xsd:sequence>
			<xsd:attribute name="Currency" use="required" type="CurrencyType"/>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="RelatedInvoiceID" type="xsd:string"/>
	<xsd:element name="BIC" type="xsd:string"/>
	<xsd:element name="InvoiceTypeID" type="xsd:string"/>

	<!-- 2010-09-30: TCN specific data for vouchers -->

	<xsd:element name="Attachments">
		<!-- extra details for UP -->

		<!-- the actual data of the document, encoded in base64 -->
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="DocumentID"/>
				<xsd:element ref="DocumentType"/>
				<xsd:element ref="BookID"/>
				<xsd:element ref="BookVersionNumber"/>
				<xsd:element ref="AttachmentsMetaData" minOccurs="0"/>
				<xsd:element ref="Attachment"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="Attachment" type="xsd:base64Binary"/>
	<xsd:element name="AttachmentsMetaData">
		<!-- the creation date of the voucher. Maps to 'Factuur Datum' -->

		<!-- the name of the first pax. Maps to 'Naam Klant' -->

		<!-- the departure date of the reservation. Maps to 'Vertrek Datum' (?) -->

		<!-- the name of the employee who created the reservation or manipulated the reservation the last. Maps to 'Contact' -->

		<!-- the amount to pay by the customer. Maps to 'Bedrag Dossier' -->
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="DocumentDate" minOccurs="0"/>
				<xsd:element ref="LeadName" minOccurs="0"/>
				<xsd:element ref="DepartureDate" minOccurs="0"/>
				<xsd:element ref="ReceiverID" minOccurs="0"/>
				<xsd:element ref="BookEmployeeID" minOccurs="0"/>
				<xsd:element ref="BookAmount" minOccurs="0"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="DocumentDate" type="xsd:date"/>
	<xsd:element name="LeadName" type="xsd:string"/>
	<xsd:element name="TravelDocumentsMeta">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="BookID"/>
				<xsd:element ref="BookVersionNumber"/>
				<xsd:element ref="TravelDocumentVersionDate"/>
				<xsd:element ref="TravelDocumentVersionTime"/>
				<xsd:element ref="LeadName"/>
				<xsd:element ref="DepartureDate"/>
				<xsd:element ref="Destination"/>
				<xsd:element ref="NumberOfItems"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="TravelDocumentItem">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="Type"/>
				<xsd:element ref="Description"/>
				<xsd:element ref="ItemIncluded"/>
				<xsd:element ref="ItemLocation" minOccurs="0"/>
				<xsd:element ref="Attachment" minOccurs="0"/>
				<xsd:element ref="ItemURL" minOccurs="0"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="NumberOfItems" type="NumberValue"/>
	<xsd:element name="Type" type="xsd:string"/>
	<xsd:element name="ItemIncluded" type="YesNoValue"/>
	<xsd:element name="TravelDocumentVersionDate" type="xsd:date"/>
	<xsd:element name="TravelDocumentVersionTime" type="xsd:time"/>
	<xsd:element name="ItemURL" type="xsd:anyURI"/>
	<xsd:element name="Discounts">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="DiscountID" type="xsd:string" minOccurs="0" maxOccurs="unbounded"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>	
</xsd:schema>

