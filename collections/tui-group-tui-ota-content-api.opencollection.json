    {
      "info": {
        "name": "G7 content",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Content API for OTA",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://prod.api.tui/sales-ota-content/v2/accommodations/:accommodation-code",
            "params": [
              {
                "name": "accommodation-code",
                "value": "",
                "type": "path",
                "description": "accommodation code (e.g. A1013029)"
              },
              {
                "name": "brand",
                "value": "",
                "type": "query",
                "description": "brand (e.g. NL)"
              },
              {
                "name": "relevantBrand",
                "value": "",
                "type": "query",
                "description": "brand (e.g. G7_NL) - If you don't pass this param then it would return web content"
              }
            ]
          },
          "docs": "This is the request/response for content API\n"
        }
      ]
    }
  ],
  "bundled": true
