            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://dev.api.tui/flight/newskies/checkinhandler/recordlocator",
            "params": [
              {
                "name": "bookingId",
                "value": "",
                "type": "query"
              },
              {
                "name": "lastName",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns the Record Locator value from the Third Party Record Locator and the passenger last name."
        },
        {
          "info": {
            "name": "Returns the CheckIn/Login status for a booking",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://dev.api.tui/flight/newskies/checkinhandler/checkinavailability",
            "params": [
              {
                "name": "bookingId",
                "value": "",
                "type": "query"
              },
              {
                "name": "lastName",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns the CheckIn/Login status from the TPRL/PNR and the passenger last name."
        }
      ]
    }
  ],
  "bundled": true
