      "items": [
        {
          "info": {
            "name": "GetAccommodationImages",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://prod.api.tui/sales/pip-package/content/v1-beta/markets/:market/accommodations/:accommodationId/images",
            "params": [
              {
                "name": "market",
                "value": "",
                "type": "path",
                "description": "The source market code.\r\n\r\nAccepted values: dk, fi, no, se."
              },
              {
                "name": "accommodationId",
                "value": "",
                "type": "path",
                "description": "The accommodation id.\r\n\r\nExample - P-500004311"
              },
              {
                "name": "agent",
                "value": "",
                "type": "query",
                "description": "Your agent code. Use the same for every request made.\r\n\r\nExample - tui"
              }
            ]
          },
          "docs": "This endpoint returns the images for specific accommodation."
        },
        {
          "info": {
            "name": "GetAccommodationContent",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://prod.api.tui/sales/pip-package/content/v1-beta/markets/:market/accommodations/:accommodationId",
            "params": [
              {
                "name": "market",
                "value": "",
                "type": "path",
                "description": "The source market code.\r\n\r\nAccepted values: dk, fi, no, se."
              },
              {
                "name": "accommodationId",
                "value": "",
                "type": "path",
                "description": "The accommodation id.\r\n\r\nExample - P-500004311"
              },
              {
                "name": "agent",
                "value": "",
                "type": "query",
                "description": "Your agent code. Use the same for every request made.\r\n\r\nExample - tui"
              }
            ]
          },
          "docs": "This endpoint returns the content of a specific accommodation."
        }
      ]
    }
  ],
